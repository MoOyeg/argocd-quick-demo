# key=value properties consumed by kustomize secretGenerator (envs:).
# These are the values that get pushed INTO Vault by the seed Job. In a real
# setup Vault would be seeded out-of-band and this file would not exist -
# it is here so the demo is self-contained and reproducible.
#
# DEMO VALUES ONLY. Nothing here is a real credential.
VAULT_TOKEN=root
PAYMENTS_DB_USERNAME=payments_svc
PAYMENTS_DB_PASSWORD=demo-not-a-real-password
PAYMENTS_DB_URL=jdbc:postgresql://postgres.payments-demo.svc:5432/payments
INVENTORY_API_KEY=demo-inventory-api-key-0000
INVENTORY_API_ENDPOINT=https://inventory.example.com/api/v2
INVENTORY_WEBHOOK_SIGNING_KEY=demo-signing-key-abcdef
