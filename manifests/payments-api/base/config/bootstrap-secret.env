# key=value properties -> kustomize secretGenerator (envs:) -> a Secret.
#
# IMPORTANT DISTINCTION, and the point of pairing this with Vault:
# kustomize secretGenerator only base64-encodes. Anything in this file is
# plaintext in git. So it is for low-sensitivity bootstrap values only.
# Real credentials (the database password) never appear in this repo - they
# live in Vault and reach the Pod through agent injection at runtime.
TELEMETRY_TOKEN=demo-telemetry-token-not-sensitive
BOOTSTRAP_CLIENT_ID=payments-demo-client
